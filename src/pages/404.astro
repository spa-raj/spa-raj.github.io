---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found | Sparsh Raj" description="This page doesn't exist.">
  <section class="hero" aria-labelledby="nf-heading">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1 id="nf-heading">Page not found</h1>
      <p class="lede">There's nothing at this address. It may have moved, or the link may be wrong.</p>
      <ul class="actions">
        <li><a class="btn" href="/">Back to the home page</a></li>
      </ul>
    </div>
  </section>
</Base>
